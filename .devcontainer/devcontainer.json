{
  "name": "MySQL Web Lab",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8080, 3306],
  "portsAttributes": {
    "8080": { "label": "Web app (PHP)" },
    "3306": { "label": "MySQL" }
  },
  "postStartCommand": "bash -c 'nohup php -S 0.0.0.0:8080 -t app > /tmp/php.log 2>&1 &'"
}
